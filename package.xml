<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>servo_pendant_webgui</name>
    <version>0.0.0</version>
    <description>Touch-friendly web teach pendant (NiceGUI) for MoveIt Servo: joint jog and twist commands</description>
    <maintainer email="julian.mueller@iwb.tum.de">jmueller</maintainer>
    <license>GPL-3.0-only</license>

    <depend>rclpy</depend>
    <depend>std_msgs</depend>
    <depend>std_srvs</depend>
    <depend>sensor_msgs</depend>
    <depend>geometry_msgs</depend>
    <depend>control_msgs</depend>
    <depend>moveit_msgs</depend>
    <exec_depend>python3-numpy</exec_depend>
    <exec_depend>ament_index_python</exec_depend>
    <!-- nicegui, trimesh and pycollada are installed with pip (into the venv) -->

    <test_depend>ament_copyright</test_depend>
    <test_depend>ament_flake8</test_depend>
    <test_depend>ament_pep257</test_depend>
    <test_depend>python3-pytest</test_depend>

    <export>
        <build_type>ament_python</build_type>
    </export>
</package>